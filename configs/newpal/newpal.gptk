# NewPAL accepts arrow keys on the title screen, but Space and Return do not
# activate the selected entry. A mouse click does. Keep a pointer and click
# available for its touch-oriented menus; the other buttons expose its native
# keyboard bindings for gameplay.
back = esc
start = enter
a = mouse_left
b = esc
x = space
y = pageup
l1 = rightshift
r1 = rightctrl
l2 = r
r2 = f1
r3 = mouse_left
up = up
down = down
left = left
right = right
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right
mouse_scale = 8192
